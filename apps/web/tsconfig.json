{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// SMUI 9 は型のために TypeScript のソースを同梱していて、svelte-check はそれも検査する。
		// SMUI のソースはこの設定を満たさないので、apps/web では外す (packages と scripts は、ルートの tsconfig で検査する)
		"noUncheckedIndexedAccess": false,
		"sourceMap": true,
		"module": "preserve"
	},
	// E2E テスト、ビルドの補助のスクリプト、Playwright の設定も型の検査に含める
	"include": [
		"src",
		"e2e/**/*.ts",
		"scripts/**/*.js",
		"vite.config.js",
		"playwright.config.js",
		"tsdown.config.js"
	]
}
